{
  "project_name": "MedPredict AI - Pneumonia Detection App",
  "description": "A Flutter mobile application for early pneumonia detection using AI, featuring patient history tracking, risk assessment, and smart health tips. Based on the 'MedPredict AI: Predictive Intelligence Model for Detecting Pneumonia' documentation.",
  "milestone": "Milestone 1 - UI/UX Design with Fixed Data",
  "technology_stack": {
    "framework": "Flutter",
    "language": "Dart",
    "state_management": "Provider or Riverpod",
    "routing": "GoRouter or Auto_route",
    "design_system": "Material Design 3"
  },
  "project_structure": {
    "lib": {
      "main.dart": "Application entry point",
      "config": {
        "theme": {
          "app_theme.dart": "App-wide theme configuration with light/dark modes",
          "app_colors.dart": "Color palette (medical blues, whites, accent colors)",
          "app_typography.dart": "Text styles and font definitions",
          "app_dimensions.dart": "Spacing, padding, and dimension constants"
        },
        "routes": {
          "app_routes.dart": "Route definitions and navigation logic",
          "route_names.dart": "Route name constants"
        },
        "constants": {
          "app_constants.dart": "Global application constants",
          "assets_constants.dart": "Asset path constants",
          "api_constants.dart": "API endpoints (for future integration)"
        }
      },
      "core": {
        "utils": {
          "validators.dart": "Input validation utilities (email, password, phone)",
          "date_formatter.dart": "Date and time formatting utilities",
          "image_helper.dart": "Image handling utilities",
          "snackbar_helper.dart": "Common snackbar messages"
        },
        "extensions": {
          "context_extensions.dart": "BuildContext extensions for theme, navigation",
          "string_extensions.dart": "String manipulation extensions",
          "datetime_extensions.dart": "DateTime formatting extensions"
        },
        "widgets": {
          "custom_app_bar.dart": "Reusable app bar widget",
          "custom_button.dart": "Primary, secondary, outline buttons",
          "custom_text_field.dart": "Styled text input fields",
          "loading_indicator.dart": "Loading spinner widget",
          "empty_state.dart": "Empty state placeholder widget",
          "error_widget.dart": "Error display widget"
        }
      },
      "screens": {
        "common": {
          "splash_screen.dart": "App launch screen with logo animation",
          "onboarding_screen.dart": "Introduction slides for first-time users"
        },
        "auth": {
          "welcome_screen.dart": "Welcome page with login/register options",
          "login_screen.dart": "User/Admin login interface",
          "register_screen.dart": "New user registration form"
        },
        "patient": {
          "dashboard": {
            "patient_dashboard_screen.dart": "Main patient home screen",
            "widgets": {
              "health_summary_card.dart": "Recent health status card",
              "quick_action_buttons.dart": "Upload X-ray, view history buttons",
              "health_tips_carousel.dart": "Rotating health tips display"
            }
          },
          "xray_upload": {
            "upload_xray_screen.dart": "Image upload interface",
            "xray_preview_screen.dart": "Preview before submission",
            "widgets": {
              "image_picker_widget.dart": "Camera/gallery selector",
              "upload_progress_widget.dart": "Upload progress indicator"
            }
          },
          "results": {
            "prediction_result_screen.dart": "Pneumonia detection result display",
            "result_details_screen.dart": "Detailed analysis breakdown",
            "widgets": {
              "risk_gauge_widget.dart": "Visual risk level indicator",
              "confidence_bar_widget.dart": "Confidence score bar chart",
              "recommendation_card.dart": "Health recommendations display"
            }
          },
          "history": {
            "medical_history_screen.dart": "Timeline of past predictions",
            "history_detail_screen.dart": "Individual record details",
            "widgets": {
              "timeline_item_widget.dart": "History timeline entry",
              "comparison_chart_widget.dart": "Progress comparison chart"
            }
          },
          "profile": {
            "patient_profile_screen.dart": "User profile and settings",
            "edit_profile_screen.dart": "Profile editing interface"
          }
        },
        "admin": {
          "dashboard": {
            "admin_dashboard_screen.dart": "Admin control panel",
            "widgets": {
              "statistics_card.dart": "System usage statistics",
              "recent_predictions_list.dart": "Latest predictions overview"
            }
          },
          "users": {
            "user_management_screen.dart": "User list and management",
            "user_details_screen.dart": "Individual user details",
            "widgets": {
              "user_card_widget.dart": "User information card",
              "user_actions_menu.dart": "Add/edit/delete user actions"
            }
          },
          "dataset": {
            "dataset_management_screen.dart": "AI model dataset management",
            "upload_dataset_screen.dart": "Upload new training data"
          },
          "health_tips": {
            "tips_management_screen.dart": "Manage health tips content",
            "add_edit_tip_screen.dart": "Create/edit health tip"
          },
          "settings": {
            "admin_settings_screen.dart": "System configuration settings"
          }
        }
      },
      "models": {
        "user_model.dart": "User entity with userId, fullName, email, phone, dateJoined",
        "admin_model.dart": "Admin entity with adminId, email",
        "health_data_model.dart": "Health data entity with imageId, userId, imagePath, uploadDate, imageFormat",
        "prediction_model.dart": "Prediction result with predictionId, imageId, result, confidenceScore, riskLevel, predictionDate",
        "medical_history_model.dart": "Medical history record with historyId, userId, predictionId, notes, recordDate",
        "health_tip_model.dart": "Health tip with tipId, tipText, category, riskLevel, createdDate",
        "enums": {
          "risk_level.dart": "Enum: MILD, MODERATE, SEVERE",
          "prediction_result.dart": "Enum: NORMAL, PNEUMONIA",
          "user_role.dart": "Enum: PATIENT, ADMIN"
        }
      },
      "services": {
        "auth_service.dart": "Authentication logic (login, register, logout) - Fixed data for Milestone 1",
        "prediction_service.dart": "Prediction retrieval and management - Fixed data",
        "history_service.dart": "Medical history operations - Fixed data",
        "health_tips_service.dart": "Health tips retrieval - Fixed data",
        "user_service.dart": "User profile management - Fixed data",
        "storage_service.dart": "Local storage using shared_preferences for session data"
      },
      "data": {
        "fixed_data": {
          "users_data.dart": "Mock user accounts (5 patients, 2 admins)",
          "predictions_data.dart": "Sample prediction results (10-15 records)",
          "medical_history_data.dart": "Sample medical history records",
          "health_tips_data.dart": "Pre-defined health tips (20+ tips)",
          "xray_images_data.dart": "Asset paths to sample X-ray images"
        }
      }
    },
    "assets": {
      "images": {
        "logo": "app_logo.png, splash_logo.png",
        "illustrations": "welcome_illustration.png, empty_history.png, success_illustration.png",
        "sample_xrays": "normal_xray_1.jpg, pneumonia_xray_1.jpg, etc."
      },
      "icons": "Custom medical-themed icons if needed",
      "fonts": "Poppins, Inter, or Roboto fonts"
    }
  },
  "functional_requirements": {
    "patient_features": [
      {
        "feature": "User Registration",
        "description": "Allow new patients to create accounts with name, email, password, phone",
        "screens": [
          "register_screen.dart"
        ],
        "validation": [
          "Email format",
          "Password strength (min 8 chars)",
          "Phone number format"
        ]
      },
      {
        "feature": "User Login",
        "description": "Authenticate patients using email and password",
        "screens": [
          "login_screen.dart"
        ],
        "fixed_data": "Pre-defined user credentials in users_data.dart"
      },
      {
        "feature": "Upload Chest X-ray",
        "description": "Select X-ray image from camera or gallery for analysis",
        "screens": [
          "upload_xray_screen.dart",
          "xray_preview_screen.dart"
        ],
        "fixed_data": "Return pre-defined prediction results from predictions_data.dart"
      },
      {
        "feature": "View Prediction Results",
        "description": "Display pneumonia detection result with confidence score and risk rating",
        "screens": [
          "prediction_result_screen.dart",
          "result_details_screen.dart"
        ],
        "components": [
          "Risk gauge (Mild/Moderate/Severe)",
          "Confidence percentage",
          "Result timestamp"
        ]
      },
      {
        "feature": "Medical History Tracking",
        "description": "View chronological timeline of all past predictions",
        "screens": [
          "medical_history_screen.dart",
          "history_detail_screen.dart"
        ],
        "features": [
          "Timeline view",
          "Filter by date",
          "Compare results",
          "Export option (future)"
        ]
      },
      {
        "feature": "Smart Health Tips",
        "description": "Display AI-generated health recommendations based on risk level",
        "screens": [
          "patient_dashboard_screen.dart (carousel)",
          "health_tips_detail_screen.dart"
        ],
        "fixed_data": "Context-aware tips from health_tips_data.dart"
      },
      {
        "feature": "Profile Management",
        "description": "View and edit user profile information",
        "screens": [
          "patient_profile_screen.dart",
          "edit_profile_screen.dart"
        ]
      },
      {
        "feature": "Logout",
        "description": "Securely log out and clear session",
        "action": "Clear stored credentials and navigate to welcome screen"
      }
    ],
    "admin_features": [
      {
        "feature": "Admin Login",
        "description": "Authenticate admin using admin credentials",
        "screens": [
          "login_screen.dart"
        ],
        "fixed_data": "Admin accounts from users_data.dart"
      },
      {
        "feature": "User Account Management",
        "description": "View, add, update, delete patient accounts",
        "screens": [
          "user_management_screen.dart",
          "user_details_screen.dart"
        ],
        "actions": [
          "List all users",
          "Search users",
          "Add new user",
          "Edit user",
          "Delete user"
        ]
      },
      {
        "feature": "View All Predictions",
        "description": "Monitor all pneumonia predictions in the system",
        "screens": [
          "admin_dashboard_screen.dart"
        ],
        "components": [
          "Total predictions count",
          "Recent predictions list",
          "Statistics charts"
        ]
      },
      {
        "feature": "Dataset Management",
        "description": "Upload and manage AI training datasets (UI only for Milestone 1)",
        "screens": [
          "dataset_management_screen.dart"
        ],
        "note": "Actual dataset upload deferred to future milestones"
      },
      {
        "feature": "Health Tips Management",
        "description": "Create, edit, delete health tips",
        "screens": [
          "tips_management_screen.dart",
          "add_edit_tip_screen.dart"
        ]
      },
      {
        "feature": "System Configuration",
        "description": "Access system settings and preferences",
        "screens": [
          "admin_settings_screen.dart"
        ]
      }
    ]
  },
