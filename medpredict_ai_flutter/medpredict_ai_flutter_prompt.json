  "code_quality_standards": {
    "architecture": "Clean Architecture with separation of concerns",
    "naming_conventions": {
      "files": "snake_case (e.g., patient_dashboard_screen.dart)",
      "classes": "PascalCase (e.g., PatientDashboardScreen)",
      "variables": "camelCase (e.g., predictionResult)",
      "constants": "lowerCamelCase with const (e.g., const primaryColor)"
    },
    "code_organization": [
      "One widget per file for screens",
      "Reusable widgets in core/widgets or screen-specific widgets folders",
      "Models use freezed or built_value for immutability",
      "Services return Future<Result<T, Error>> for error handling",
      "Use dependency injection (get_it or riverpod providers)"
    ],
    "documentation": [
      "Dartdoc comments for all public classes and methods",
      "Inline comments for complex logic",
      "README.md with setup instructions and architecture overview"
    ],
    "testing_setup": [
      "Unit tests for services and models (test/ folder)",
      "Widget tests for critical UI components",
      "Golden tests for screen snapshots (optional for Milestone 1)"
    ]
  },
  "packages_to_use": {
    "essential": [
      "provider ^6.1.0 or riverpod ^2.4.0 - State management",
      "go_router ^13.0.0 - Navigation and routing",
      "shared_preferences ^2.2.0 - Local data persistence",
      "flutter_svg ^2.0.0 - SVG icon support",
      "cached_network_image ^3.3.0 - Image caching (future API calls)",
      "intl ^0.18.0 - Date formatting and localization"
    ],
    "ui_enhancements": [
      "google_fonts ^6.1.0 - Custom fonts",
      "fl_chart ^0.66.0 - Charts for statistics",
      "lottie ^3.0.0 - Animated illustrations",
      "shimmer ^3.0.0 - Loading skeleton screens",
      "flutter_animate ^4.5.0 - Smooth animations"
    ],
    "utilities": [
      "image_picker ^1.0.0 - Camera/gallery access",
      "path_provider ^2.1.0 - File system paths",
      "uuid ^4.0.0 - Unique ID generation",
      "logger ^2.0.0 - Debug logging",
      "freezed ^2.4.0 - Immutable models (dev dependency)"
    ]
  },
