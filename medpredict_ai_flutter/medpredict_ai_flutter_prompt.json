  "development_workflow": {
    "step_1": "Setup Flutter project and folder structure",
    "step_2": "Configure theme, colors, typography in config/",
    "step_3": "Create all data models in models/",
    "step_4": "Populate fixed data in data/fixed_data/",
    "step_5": "Implement services with fixed data responses",
    "step_6": "Build core reusable widgets",
    "step_7": "Implement authentication screens",
    "step_8": "Implement patient screens (dashboard, upload, results, history)",
    "step_9": "Implement admin screens (dashboard, users, tips)",
    "step_10": "Setup navigation and routing",
    "step_11": "Polish UI/UX with animations and transitions",
    "step_12": "Test on multiple screen sizes and orientations",
    "step_13": "Document code and create README"
  },
  "future_milestones": {
